<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.museummate.controller.CatatPemeriksaanController"
      prefWidth="520.0" spacing="16" style="-fx-padding: 24px;"
      stylesheets="@../css/style.css">

    <VBox spacing="4">
        <Label text="Catat Pemeriksaan Fisik Koleksi" styleClass="page-title" />
        <Label text="Pemeriksaan fisik akan langsung memperbarui kondisi terbaru koleksi di basis data." styleClass="page-subtitle" />
    </VBox>

    <Separator />

    <VBox spacing="12">
        <VBox spacing="4">
            <Label text="Pilih Koleksi yang Diperiksa *" styleClass="form-label" />
            <ComboBox fx:id="cmbKoleksi" maxWidth="Infinity" promptText="-- Pilih Benda Koleksi --" />
        </VBox>

        <GridPane hgap="12" vgap="12">
            <columnConstraints>
                <ColumnConstraints percentWidth="50" />
                <ColumnConstraints percentWidth="50" />
            </columnConstraints>

            <VBox spacing="4" GridPane.rowIndex="0" GridPane.columnIndex="0">
                <Label text="Tanggal Pemeriksaan *" styleClass="form-label" />
                <DatePicker fx:id="dpTanggal" maxWidth="Infinity" />
                <Label text="* Tidak boleh di masa depan" style="-fx-font-size: 10px; -fx-text-fill: #94a3b8;" />
            </VBox>

            <VBox spacing="4" GridPane.rowIndex="0" GridPane.columnIndex="1">
                <Label text="Kondisi Hasil Pemeriksaan *" styleClass="form-label" />
                <ComboBox fx:id="cmbKondisiHasil" maxWidth="Infinity" />
            </VBox>
        </GridPane>

        <VBox spacing="4">
            <Label text="Tindakan Konservasi Dilakukan *" styleClass="form-label" />
            <TextField fx:id="txtTindakan" promptText="mis: Pembersihan debu kering &amp; penggantian silika gel" />
        </VBox>

        <VBox spacing="4">
            <Label text="Catatan Pengamatan Khusus" styleClass="form-label" />
            <TextArea fx:id="txtCatatan" prefRowCount="3" promptText="Temuan kondisi fisik, retakan mikro, kelembaban, dll." wrapText="true" />
        </VBox>
    </VBox>

    <Separator />

    <HBox alignment="CENTER_RIGHT" spacing="12">
        <Button text="Batal" onAction="#handleBatal" styleClass="btn-secondary" />
        <Button text="Simpan Pemeriksaan" onAction="#handleSimpan" styleClass="btn-primary" />
    </HBox>

</VBox>
