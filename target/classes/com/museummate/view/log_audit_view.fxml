<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.museummate.controller.LogAuditController"
      spacing="16" style="-fx-background-color: transparent;">

    <!-- Page Header -->
    <HBox alignment="CENTER_LEFT" spacing="16">
        <VBox spacing="3" HBox.hgrow="ALWAYS">
            <Label text="Log Audit Aktivitas Sistem (PRD F10 / UC-13)" styleClass="page-title" />
            <Label text="Penelusuran jejak rekam aktivitas tambah, ubah, dan hapus data untuk pengawasan dan akuntabilitas."
                   styleClass="page-subtitle" />
        </VBox>
        <Button text="🔄 Segarkan Log" onAction="#handleRefresh" styleClass="btn-secondary" />
    </HBox>

    <!-- Filter & Search Toolbar -->
    <HBox spacing="12" alignment="CENTER_LEFT" styleClass="card" style="-fx-padding: 12px 16px;">
        <Label text="🔍 Cari:" style="-fx-font-weight: bold; -fx-text-fill: #475569;" />
        <TextField fx:id="txtSearch" promptText="Cari keterangan, petugas, atau username..."
                   prefWidth="280.0" onKeyReleased="#handleFilterChanged" />

        <Label text="Aksi:" style="-fx-font-weight: bold; -fx-text-fill: #475569;" />
        <ComboBox fx:id="cmbAksiFilter" prefWidth="140.0" onAction="#handleFilterChanged" />

        <Label text="Tabel:" style="-fx-font-weight: bold; -fx-text-fill: #475569;" />
        <ComboBox fx:id="cmbTabelFilter" prefWidth="160.0" onAction="#handleFilterChanged" />

        <Region HBox.hgrow="ALWAYS" />

        <Button text="Reset Filter" onAction="#handleResetFilter" styleClass="btn-secondary" />
    </HBox>

    <!-- Table Audit Logs -->
    <VBox styleClass="card" VBox.vgrow="ALWAYS" spacing="10">
        <TableView fx:id="tableLog" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colWaktu" text="Waktu &amp; Tanggal" prefWidth="160.0" />
                <TableColumn fx:id="colPengguna" text="Pengguna / Pelaku" prefWidth="180.0" />
                <TableColumn fx:id="colAksi" text="Jenis Aksi" prefWidth="110.0" />
                <TableColumn fx:id="colTabel" text="Tabel Terkait" prefWidth="130.0" />
                <TableColumn fx:id="colKeterangan" text="Keterangan Perubahan / Aktivitas" prefWidth="480.0" />
            </columns>
            <placeholder>
                <Label text="Belum ada catatan aktivitas log audit yang terekam." />
            </placeholder>
        </TableView>

        <!-- Status Summary Bar -->
        <HBox alignment="CENTER_LEFT">
            <Label fx:id="lblStatusLog" text="Memuat catatan aktivitas..."
                   style="-fx-font-size: 12px; -fx-text-fill: #64748b;" />
        </HBox>
    </VBox>

</VBox>
