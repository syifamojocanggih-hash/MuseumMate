<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.museummate.controller.JadwalController"
      spacing="16">

    <!-- Header Section -->
    <HBox alignment="CENTER_LEFT" spacing="16">
        <VBox spacing="3" HBox.hgrow="ALWAYS">
            <Label text="Jadwal Perawatan Koleksi Museum" styleClass="page-title" />
            <Label text="Perencanaan agenda konservasi berkala. Jadwal yang telah melewati tanggal rencana ditandai otomatis sebagai terlambat." styleClass="page-subtitle" />
        </VBox>
        <Button fx:id="btnTambahJadwal" text="+ Susun Jadwal Baru" onAction="#handleTambahJadwal" styleClass="btn-primary" />
    </HBox>

    <!-- Overdue Alert Ribbon if any -->
    <HBox fx:id="boxAlertTerlambat" styleClass="card" alignment="CENTER_LEFT" spacing="12"
          style="-fx-background-color: #fff7ed; -fx-border-color: #fdba74; -fx-padding: 10px 16px;">
        <Label text="⚠️" style="-fx-font-size: 16px;" />
        <Label fx:id="lblAlertTerlambatText" text="Terdapat 0 jadwal perawatan yang berstatus terlambat."
               style="-fx-font-weight: bold; -fx-text-fill: #9a3412;" />
    </HBox>

    <!-- Table of Schedules -->
    <VBox styleClass="card" VBox.vgrow="ALWAYS" spacing="10">
        <TableView fx:id="tableJadwal" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colTanggalRencana" text="Tanggal Rencana" prefWidth="140.0" />
                <TableColumn fx:id="colStatusVisual" text="Status Operasional" prefWidth="160.0" />
                <TableColumn fx:id="colKode" text="Kode Koleksi" prefWidth="120.0" />
                <TableColumn fx:id="colNama" text="Nama Koleksi" prefWidth="250.0" />
                <TableColumn fx:id="colKegiatan" text="Kegiatan Perawatan" prefWidth="260.0" />
                <TableColumn fx:id="colKeterangan" text="Keterangan Rencana" prefWidth="240.0" />
            </columns>
            <placeholder>
                <Label text="Belum ada jadwal perawatan yang disusun." />
            </placeholder>
        </TableView>

        <!-- Actions -->
        <HBox alignment="CENTER_RIGHT" spacing="10" style="-fx-padding: 6px 0 0 0;">
            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="btnSelesai" text="✅ Tandai Selesai" onAction="#handleTandaiSelesai" styleClass="btn-secondary" />
            <Button fx:id="btnBatal" text="❌ Batalkan Jadwal" onAction="#handleBatalkanJadwal" styleClass="btn-secondary" />
            <Button fx:id="btnHapus" text="🗑️ Hapus" onAction="#handleHapusJadwal" styleClass="btn-danger" />
        </HBox>
    </VBox>

</VBox>
