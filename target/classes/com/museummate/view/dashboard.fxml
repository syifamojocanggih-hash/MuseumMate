<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.museummate.controller.DashboardController"
            fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;">

    <VBox spacing="20">
        <!-- Page Header -->
        <HBox alignment="CENTER_LEFT" spacing="16">
            <VBox spacing="3" HBox.hgrow="ALWAYS">
                <Label text="Dashboard Ringkasan Operasional" styleClass="page-title" />
                <Label text="Pemantauan kondisi fisik koleksi museum, status perawatan, dan kalkulasi prioritas otomatis." styleClass="page-subtitle" />
            </VBox>
            <Button text="🔄 Segarkan Data" onAction="#refreshDashboard" styleClass="btn-secondary" />
        </HBox>

        <!-- Metric Stat Cards -->
        <HBox spacing="16">
            <VBox styleClass="stat-card" HBox.hgrow="ALWAYS" spacing="4">
                <Label text="TOTAL KOLEKSI TERDAFTAR" styleClass="stat-label" />
                <Label fx:id="lblTotalKoleksi" text="0" styleClass="stat-value" />
                <Label text="Terdata dalam 4 kategori OOP" style="-fx-font-size: 11px; -fx-text-fill: #94a3b8;" />
            </VBox>

            <VBox styleClass="stat-card" HBox.hgrow="ALWAYS" spacing="4" style="-fx-border-color: #fca5a5;">
                <Label text="PRIORITAS KRITIS / TINGGI" styleClass="stat-label" style="-fx-text-fill: #991b1b;" />
                <Label fx:id="lblPrioritasKritis" text="0" styleClass="stat-value" style="-fx-text-fill: #dc2626;" />
                <Label text="Mendesak untuk ditindaklanjuti" style="-fx-font-size: 11px; -fx-text-fill: #b91c1c;" />
            </VBox>

            <VBox styleClass="stat-card" HBox.hgrow="ALWAYS" spacing="4" style="-fx-border-color: #fdba74;">
                <Label text="JADWAL TERLAMBAT" styleClass="stat-label" style="-fx-text-fill: #9a3412;" />
                <Label fx:id="lblJadwalTerlambat" text="0" styleClass="stat-value" style="-fx-text-fill: #d97706;" />
                <Label text="Melewati tanggal rencana belum selesai" style="-fx-font-size: 11px; -fx-text-fill: #ea580c;" />
            </VBox>

            <VBox styleClass="stat-card" HBox.hgrow="ALWAYS" spacing="4" style="-fx-border-color: #86efac;">
                <Label text="KONDISI BAIK / PRIMA" styleClass="stat-label" style="-fx-text-fill: #166534;" />
                <Label fx:id="lblKondisiBaik" text="0" styleClass="stat-value" style="-fx-text-fill: #16a34a;" />
                <Label text="Stabil dalam ruang vitrin/galeri" style="-fx-font-size: 11px; -fx-text-fill: #15803d;" />
            </VBox>
        </HBox>

        <!-- Two Columns: Category Breakdown & Condition Breakdown -->
        <HBox spacing="16">
            <!-- Kategori Card -->
            <VBox styleClass="card" HBox.hgrow="ALWAYS" spacing="12">
                <Label text="Sebaran Koleksi Berdasarkan Kategori" styleClass="card-title" />
                <GridPane hgap="16" vgap="12">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="60" />
                        <ColumnConstraints percentWidth="40" halignment="RIGHT" />
                    </columnConstraints>

                    <Label text="📜 Naskah Kuno (Faktor 1.5)" GridPane.rowIndex="0" GridPane.columnIndex="0" />
                    <Label fx:id="lblNaskahCount" text="0 item" style="-fx-font-weight: bold;" GridPane.rowIndex="0" GridPane.columnIndex="1" />

                    <Label text="🎨 Lukisan Tradisional/Modern (Faktor 1.2)" GridPane.rowIndex="1" GridPane.columnIndex="0" />
                    <Label fx:id="lblLukisanCount" text="0 item" style="-fx-font-weight: bold;" GridPane.rowIndex="1" GridPane.columnIndex="1" />

                    <Label text="🏺 Artefak &amp; Senjata Sejarah (Faktor 1.0)" GridPane.rowIndex="2" GridPane.columnIndex="0" />
                    <Label fx:id="lblArtefakCount" text="0 item" style="-fx-font-weight: bold;" GridPane.rowIndex="2" GridPane.columnIndex="1" />

                    <Label text="🦴 Fosil &amp; Paleontologi (Faktor 0.8)" GridPane.rowIndex="3" GridPane.columnIndex="0" />
                    <Label fx:id="lblFosilCount" text="0 item" style="-fx-font-weight: bold;" GridPane.rowIndex="3" GridPane.columnIndex="1" />
                </GridPane>
            </VBox>

            <!-- Kondisi Card -->
            <VBox styleClass="card" HBox.hgrow="ALWAYS" spacing="12">
                <Label text="Kondisi Fisik Koleksi Terkini" styleClass="card-title" />
                <GridPane hgap="16" vgap="12">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="60" />
                        <ColumnConstraints percentWidth="40" halignment="RIGHT" />
                    </columnConstraints>

                    <HBox alignment="CENTER_LEFT" spacing="8" GridPane.rowIndex="0" GridPane.columnIndex="0">
                        <Label text="●" style="-fx-text-fill: #16a34a; -fx-font-size: 14px;" />
                        <Label text="Baik (Bobot 1)" />
                    </HBox>
                    <Label fx:id="lblDetilBaik" text="0" style="-fx-font-weight: bold;" GridPane.rowIndex="0" GridPane.columnIndex="1" />

                    <HBox alignment="CENTER_LEFT" spacing="8" GridPane.rowIndex="1" GridPane.columnIndex="0">
                        <Label text="●" style="-fx-text-fill: #2563eb; -fx-font-size: 14px;" />
                        <Label text="Cukup (Bobot 2)" />
                    </HBox>
                    <Label fx:id="lblDetilCukup" text="0" style="-fx-font-weight: bold;" GridPane.rowIndex="1" GridPane.columnIndex="1" />

                    <HBox alignment="CENTER_LEFT" spacing="8" GridPane.rowIndex="2" GridPane.columnIndex="0">
                        <Label text="●" style="-fx-text-fill: #d97706; -fx-font-size: 14px;" />
                        <Label text="Rusak Ringan (Bobot 3)" />
                    </HBox>
                    <Label fx:id="lblDetilRingan" text="0" style="-fx-font-weight: bold;" GridPane.rowIndex="2" GridPane.columnIndex="1" />

                    <HBox alignment="CENTER_LEFT" spacing="8" GridPane.rowIndex="3" GridPane.columnIndex="0">
                        <Label text="●" style="-fx-text-fill: #dc2626; -fx-font-size: 14px;" />
                        <Label text="Rusak Berat (Bobot 4)" />
                    </HBox>
                    <Label fx:id="lblDetilBerat" text="0" style="-fx-font-weight: bold;" GridPane.rowIndex="3" GridPane.columnIndex="1" />
                </GridPane>
            </VBox>
        </HBox>

        <!-- Top Urgent Priority Table Preview -->
        <VBox styleClass="card" spacing="12">
            <HBox alignment="CENTER_LEFT">
                <VBox spacing="2" HBox.hgrow="ALWAYS">
                    <Label text="Daftar Teratas Tindak Lanjut Konservasi (Skor Tertinggi)" styleClass="card-title" />
                    <Label text="Dihitung secara real-time dari kombinasi bobot kondisi, hari terlewat, dan faktor kerentanan kategori."
                           style="-fx-font-size: 12px; -fx-text-fill: #64748b;" />
                </VBox>
            </HBox>

            <TableView fx:id="tableTopPrioritas" prefHeight="220.0">
                <columns>
                    <TableColumn fx:id="colKode" text="Kode Registrasi" prefWidth="120.0" />
                    <TableColumn fx:id="colNama" text="Nama Koleksi" prefWidth="280.0" />
                    <TableColumn fx:id="colKategori" text="Kategori" prefWidth="110.0" />
                    <TableColumn fx:id="colKondisi" text="Kondisi" prefWidth="120.0" />
                    <TableColumn fx:id="colHari" text="Hari Terlewat" prefWidth="110.0" />
                    <TableColumn fx:id="colSkor" text="Skor Prioritas" prefWidth="110.0" />
                    <TableColumn fx:id="colUrgensi" text="Urgensi" prefWidth="110.0" />
                </columns>
                <placeholder>
                    <Label text="Belum ada data koleksi yang membutuhkan perawatan." />
                </placeholder>
            </TableView>
        </VBox>
    </VBox>
</ScrollPane>
