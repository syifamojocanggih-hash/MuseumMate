<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.museummate.controller.LoginController"
           prefHeight="600.0" prefWidth="900.0"
           stylesheets="@../css/style.css"
           style="-fx-background-color: #0f172a;">

    <VBox alignment="CENTER" maxWidth="420.0" spacing="0">
        <!-- Brand Header -->
        <VBox alignment="CENTER" spacing="4" style="-fx-padding: 0 0 24px 0;">
            <Label text="MUSEUMMATE" style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #f59e0b;" />
            <Label text="Sistem Manajemen Koleksi &amp; Konservasi Museum"
                   style="-fx-font-size: 13px; -fx-text-fill: #94a3b8;" />
            <Label text="Prioritas Perawatan Otomatis — Algoritma PRD 6.4"
                   style="-fx-font-size: 11px; -fx-text-fill: #64748b;" />
        </VBox>

        <!-- Login Card -->
        <VBox styleClass="card" spacing="16" style="-fx-background-color: #ffffff; -fx-background-radius: 12px; -fx-padding: 28px;">
            <VBox spacing="4">
                <Label text="Masuk ke Akun" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1e293b;" />
                <Label text="Pilih akun Administrator atau Konservator" style="-fx-font-size: 12px; -fx-text-fill: #64748b;" />
            </VBox>

            <Label fx:id="lblError" text="" visible="false" managed="false"
                   style="-fx-text-fill: #dc2626; -fx-background-color: #fee2e2; -fx-padding: 8px 12px; -fx-background-radius: 6px; -fx-font-size: 12px;" />

            <VBox spacing="6">
                <Label text="Username" styleClass="form-label" />
                <TextField fx:id="txtUsername" promptText="Masukkan username (mis: admin / konservator)" />
            </VBox>

            <VBox spacing="6">
                <Label text="Kata Sandi (Password)" styleClass="form-label" />
                <PasswordField fx:id="txtPassword" promptText="Masukkan kata sandi" />
            </VBox>

            <Button fx:id="btnLogin" text="Masuk ke Sistem" onAction="#handleLogin"
                    maxWidth="Infinity" styleClass="btn-primary" style="-fx-font-size: 14px; -fx-padding: 10px;" />

            <Separator style="-fx-padding: 8px 0 0 0;" />

            <!-- Demo Hint Credentials -->
            <VBox spacing="4" style="-fx-background-color: #f8fafc; -fx-padding: 10px; -fx-background-radius: 6px; -fx-border-color: #e2e8f0; -fx-border-radius: 6px;">
                <Label text="Akun Demo Bawaan:" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #475569;" />
                <HBox spacing="10">
                    <Hyperlink text="Isi Admin (admin / admin123)" onAction="#fillAdminDemo" style="-fx-font-size: 11px; -fx-text-fill: #92400e; -fx-padding: 0;" />
                    <Label text="•" style="-fx-text-fill: #94a3b8;" />
                    <Hyperlink text="Isi Konservator (konservator / konservator123)" onAction="#fillKonservatorDemo" style="-fx-font-size: 11px; -fx-text-fill: #92400e; -fx-padding: 0;" />
                </HBox>
            </VBox>
        </VBox>

        <Label text="Team 8 — D3 Teknik Informatika PSDKU Lamongan, PENS (2026)"
               style="-fx-font-size: 11px; -fx-text-fill: #475569; -fx-padding: 20px 0 0 0;" />
    </VBox>

</StackPane>
