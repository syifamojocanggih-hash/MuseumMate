<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.museummate.controller.LoginController"
           prefHeight="620.0" prefWidth="920.0"
           stylesheets="@../css/style.css"
           style="-fx-background-color: #0b0f19;">

    <VBox alignment="CENTER" maxWidth="430.0" spacing="0">
        <!-- Brand Header -->
        <VBox alignment="CENTER" spacing="5" style="-fx-padding: 0 0 24px 0;">
            <Label text="MUSEUMMATE" style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #38bdf8; -fx-letter-spacing: 1px;" />
            <Label text="Sistem Manajemen Koleksi &amp; Konservasi Cagar Budaya"
                   style="-fx-font-size: 13px; -fx-text-fill: #cbd5e1;" />
            <Label text="Museum Surabaya (Gedung Siola) (Kalkulasi Prioritas PRD 6.4)"
                   style="-fx-font-size: 11px; -fx-text-fill: #94a3b8; -fx-font-weight: bold;" />
        </VBox>

        <!-- Login Card -->
        <VBox styleClass="card" spacing="16" style="-fx-background-color: #ffffff; -fx-background-radius: 14px; -fx-padding: 30px; -fx-effect: dropshadow(gaussian, rgba(0, 0, 0, 0.35), 28, 0, 0, 10);">
            <VBox spacing="4">
                <Label text="Masuk ke Akun" style="-fx-font-size: 19px; -fx-font-weight: bold; -fx-text-fill: #0f172a;" />
                <Label text="Pilih akun Administrator atau Konservator" style="-fx-font-size: 12px; -fx-text-fill: #64748b;" />
            </VBox>

            <Label fx:id="lblError" text="" visible="false" managed="false"
                   style="-fx-text-fill: #dc2626; -fx-background-color: #fee2e2; -fx-padding: 8px 12px; -fx-background-radius: 6px; -fx-font-size: 12px;" />

            <VBox spacing="6">
                <Label text="Username" styleClass="form-label" />
                <TextField fx:id="txtUsername" promptText="Masukkan username (mis: admin / konservator)" />
            </VBox>

            <VBox spacing="6">
                <Label text="Kata Sandi (Password)" styleClass="form-label" />
                <PasswordField fx:id="txtPassword" promptText="Masukkan kata sandi" />
            </VBox>

            <Button fx:id="btnLogin" text="Masuk ke Sistem" onAction="#handleLogin"
                    maxWidth="Infinity" styleClass="btn-primary" style="-fx-font-size: 14px; -fx-padding: 11px;" />

            <Separator style="-fx-padding: 6px 0 0 0;" />

            <!-- Demo Hint Credentials -->
            <VBox spacing="5" style="-fx-background-color: #f8fafc; -fx-padding: 12px; -fx-background-radius: 8px; -fx-border-color: #e2e8f0; -fx-border-radius: 8px;">
                <Label text="Akun Demo Bawaan:" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #475569;" />
                <HBox spacing="10">
                    <Hyperlink text="Isi Admin (admin / admin123)" onAction="#fillAdminDemo" style="-fx-font-size: 11px; -fx-text-fill: #2563eb; -fx-padding: 0; -fx-font-weight: bold;" />
                    <Label text="•" style="-fx-text-fill: #94a3b8;" />
                    <Hyperlink text="Isi Konservator (konservator / konservator123)" onAction="#fillKonservatorDemo" style="-fx-font-size: 11px; -fx-text-fill: #2563eb; -fx-padding: 0; -fx-font-weight: bold;" />
                </HBox>
            </VBox>
        </VBox>

        <Label text="Team 8, D3 Teknik Informatika PSDKU Lamongan, PENS (2026)"
               style="-fx-font-size: 11px; -fx-text-fill: #64748b; -fx-padding: 22px 0 0 0;" />
    </VBox>

</StackPane>
