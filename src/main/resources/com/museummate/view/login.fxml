<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<HBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.museummate.controller.LoginController"
      prefHeight="640.0" prefWidth="980.0"
      styleClass="login-split-root"
      stylesheets="@../css/style.css">

    <!-- ================================================================= -->
    <!-- LEFT PANEL: Museum Surabaya (Gedung Siola) Exhibition Showcase    -->
    <!-- ================================================================= -->
    <StackPane fx:id="visualPane" HBox.hgrow="ALWAYS" minWidth="440.0" prefWidth="490.0"
               styleClass="login-visual-pane">

        <!-- Authentic Siola Museum Timeline Wall Image -->
        <ImageView fx:id="imgVisual" preserveRatio="false">
            <image>
                <Image url="@../images/siola_exhibition.jpg" />
            </image>
        </ImageView>

        <!-- Dark Gradient Overlay with Curatorial Brand Presentation -->
        <VBox alignment="BOTTOM_LEFT" spacing="14" styleClass="login-visual-overlay">

            <Region VBox.vgrow="ALWAYS" />

            <!-- Heritage Headline & Timeline Description -->
            <VBox spacing="8" maxWidth="430.0">
                <Label text="GALERI TIMELINE &amp; SEJARAH KOTA"
                       style="-fx-font-size: 11.5px; -fx-text-fill: #7EAED4; -fx-font-weight: 800; -fx-letter-spacing: 1px;" />

                <Label text="Menjaga Jejak Peradaban&#10;Sejak Abad Ke-10"
                       styleClass="login-visual-headline" />

                <Label text="Dokumentasi komprehensif perjalanan Surabaya dari era Kerajaan Medang, Singosari, Majapahit (1293), hingga masa perjuangan kemerdekaan di Gedung Siola."
                       styleClass="login-visual-description" wrapText="true" />
            </VBox>

            <!-- Curatorial Category Badges (Clean Typography without Broken Emojis) -->
            <HBox spacing="8" style="-fx-padding: 6px 0 0 0;">
                <Label text="Lukisan" styleClass="museum-category-chip" />
                <Label text="Artefak" styleClass="museum-category-chip" />
                <Label text="Naskah Kuno" styleClass="museum-category-chip" />
                <Label text="Fosil" styleClass="museum-category-chip" />
            </HBox>

            <!-- Museum Location Footer -->
            <Label text="Gedung Siola, Jl. Tunjungan No. 1, Genteng, Kota Surabaya"
                   style="-fx-font-size: 11px; -fx-text-fill: #94a3b8; -fx-padding: 10px 0 0 0;" />
        </VBox>
    </StackPane>

    <!-- ================================================================= -->
    <!-- RIGHT PANEL: Clean Modern Login Form (Centered)                  -->
    <!-- ================================================================= -->
    <StackPane HBox.hgrow="ALWAYS" minWidth="460.0" prefWidth="490.0"
               style="-fx-background-color: #ffffff;">
        <ScrollPane fitToWidth="true" fitToHeight="true"
                    styleClass="login-form-scroll">
            <StackPane alignment="CENTER" minHeight="-Infinity" style="-fx-padding: 32px 36px;">
                <VBox alignment="CENTER" maxWidth="430.0" spacing="16">

                    <!-- Brand Header with Rich Gradient Typography -->
                    <VBox alignment="CENTER" spacing="3" maxWidth="Infinity">
                        <Label text="MUSEUMMATE" styleClass="login-brand-title" />
                        <Label text="Sistem Manajemen Koleksi &amp; Konservasi Cagar Budaya"
                               styleClass="login-brand-sub" />
                        <HBox prefHeight="3.0" prefWidth="64.0" maxWidth="64.0"
                              style="-fx-background-color: #174C78; -fx-background-radius: 2px;">
                            <VBox.margin>
                                <Insets top="4" bottom="10" />
                            </VBox.margin>
                        </HBox>
                    </VBox>

                    <!-- Form Heading -->
                    <VBox alignment="CENTER" spacing="3" maxWidth="Infinity">
                        <Label text="Masuk ke Akun" styleClass="login-heading" />
                        <Label text="Pilih akun Administrator atau Konservator untuk melanjutkan"
                               styleClass="login-subheading" />
                    </VBox>

                    <!-- Error Banner -->
                    <Label fx:id="lblError" text="" visible="false" managed="false" maxWidth="Infinity"
                           style="-fx-text-fill: #dc2626; -fx-background-color: #fef2f2; -fx-border-color: #fecaca; -fx-border-width: 1px; -fx-padding: 9px 12px; -fx-background-radius: 8px; -fx-border-radius: 8px; -fx-font-size: 12px;" />

                    <!-- Input Username -->
                    <VBox spacing="6" maxWidth="Infinity">
                        <Label text="Username" styleClass="login-field-label" />
                        <HBox fx:id="boxUsername" styleClass="login-input-box" spacing="8">
                            <Label text="👤" styleClass="login-input-icon" />
                            <TextField fx:id="txtUsername" promptText="Masukkan username"
                                       HBox.hgrow="ALWAYS" styleClass="login-text-field" />
                        </HBox>
                    </VBox>

                    <!-- Input Password -->
                    <VBox spacing="6" maxWidth="Infinity">
                        <HBox alignment="CENTER_LEFT">
                            <Label text="Kata Sandi (Password)" styleClass="login-field-label" />
                        </HBox>
                        <HBox fx:id="boxPassword" styleClass="login-input-box" spacing="8">
                            <Label text="🔒" styleClass="login-input-icon" />
                            <StackPane HBox.hgrow="ALWAYS" alignment="CENTER_LEFT">
                                <PasswordField fx:id="txtPassword" promptText="Masukkan kata sandi"
                                               maxWidth="Infinity" styleClass="login-text-field" />
                                <TextField fx:id="txtPasswordPlain" promptText="Masukkan kata sandi"
                                           visible="false" managed="false"
                                           maxWidth="Infinity" styleClass="login-text-field" />
                            </StackPane>
                            <Button fx:id="btnTogglePassword" text="👁" onAction="#togglePasswordVisibility"
                                    styleClass="login-eye-btn" focusTraversable="false" />
                        </HBox>
                    </VBox>

                    <!-- Submit Button -->
                    <Button fx:id="btnLogin" text="Masuk ke Sistem" onAction="#handleLogin"
                            maxWidth="Infinity" styleClass="login-submit-btn">
                        <VBox.margin>
                            <Insets top="4" />
                        </VBox.margin>
                    </Button>

                    <!-- Divider -->
                    <HBox alignment="CENTER" spacing="10" maxWidth="Infinity" style="-fx-padding: 4px 0;">
                        <Separator HBox.hgrow="ALWAYS" />
                        <Label text="Atau Masuk Cepat dengan Akun Demo"
                               style="-fx-font-size: 11px; -fx-text-fill: #94a3b8; -fx-font-weight: 500;" />
                        <Separator HBox.hgrow="ALWAYS" />
                    </HBox>

                    <!-- Demo Quick-Fill Buttons -->
                    <HBox spacing="10" maxWidth="Infinity">
                        <Button onAction="#fillAdminDemo" HBox.hgrow="ALWAYS" maxWidth="Infinity"
                                styleClass="login-demo-btn">
                            <graphic>
                                <VBox spacing="2">
                                    <Label text="Admin" style="-fx-font-weight: bold; -fx-font-size: 12px; -fx-text-fill: #174C78;" />
                                    <Label text="admin / admin123" style="-fx-font-size: 11px; -fx-text-fill: #64748b;" />
                                </VBox>
                            </graphic>
                        </Button>

                        <Button onAction="#fillKonservatorDemo" HBox.hgrow="ALWAYS" maxWidth="Infinity"
                                styleClass="login-demo-btn">
                            <graphic>
                                <VBox spacing="2">
                                    <Label text="Konservator" style="-fx-font-weight: bold; -fx-font-size: 12px; -fx-text-fill: #047857;" />
                                    <Label text="konservator / konservator123" style="-fx-font-size: 11px; -fx-text-fill: #64748b;" />
                                </VBox>
                            </graphic>
                        </Button>
                    </HBox>

                    <!-- Footer Attribution -->
                    <Label text="Team 8, D3 Teknik Informatika PSDKU Lamongan, PENS (2026)"
                           style="-fx-font-size: 11px; -fx-text-fill: #94a3b8; -fx-padding: 8px 0 0 0;" />
                </VBox>
            </StackPane>
        </ScrollPane>
    </StackPane>
</HBox>

