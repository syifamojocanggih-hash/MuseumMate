<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<HBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.museummate.controller.LoginController"
      prefHeight="680.0" prefWidth="1020.0"
      styleClass="login-split-root"
      stylesheets="@../css/style.css">

    <!-- ================================================================= -->
    <!-- LEFT PANEL: Museum Surabaya (Gedung Siola) Exhibition Showcase    -->
    <!-- ================================================================= -->
    <StackPane fx:id="visualPane" HBox.hgrow="ALWAYS" minWidth="440.0" prefWidth="480.0"
               styleClass="login-visual-pane">

        <!-- Authentic Siola Museum Timeline Wall Image -->
        <ImageView fx:id="imgVisual" preserveRatio="false">
            <image>
                <Image url="@../images/siola_exhibition.jpg" />
            </image>
        </ImageView>

        <!-- Dark Gradient Overlay with Curatorial Brand Presentation -->
        <VBox alignment="BOTTOM_LEFT" spacing="14" styleClass="login-visual-overlay">

            <Region VBox.vgrow="ALWAYS" />

            <!-- Heritage Headline & Timeline Description -->
            <VBox spacing="8" maxWidth="430.0">
                <Label text="GALERI TIMELINE &amp; SEJARAH KOTA"
                       style="-fx-font-size: 11.5px; -fx-text-fill: #7EAED4; -fx-font-weight: 800; -fx-letter-spacing: 1px;" />

                <Label text="Menjaga Jejak Peradaban&#10;Sejak Abad Ke-10"
                       styleClass="login-visual-headline" />

                <Label text="Dokumentasi komprehensif perjalanan Surabaya dari era Kerajaan Medang, Singosari, Majapahit (1293), hingga masa perjuangan kemerdekaan di Gedung Siola."
                       styleClass="login-visual-description" wrapText="true" />
            </VBox>

            <!-- Curatorial Category Badges -->
            <HBox spacing="8" style="-fx-padding: 6px 0 0 0;">
                <Label text="Lukisan" styleClass="museum-category-chip" />
                <Label text="Artefak" styleClass="museum-category-chip" />
                <Label text="Naskah Kuno" styleClass="museum-category-chip" />
                <Label text="Fosil" styleClass="museum-category-chip" />
            </HBox>

            <!-- Museum Location Footer -->
            <Label text="Gedung Siola, Jl. Tunjungan No. 1, Genteng, Kota Surabaya"
                   style="-fx-font-size: 11px; -fx-text-fill: #94a3b8; -fx-padding: 10px 0 0 0;" />
        </VBox>
    </StackPane>

    <!-- ================================================================= -->
    <!-- RIGHT PANEL: Clean Modern Login Form (Centered)                  -->
    <!-- ================================================================= -->
    <StackPane HBox.hgrow="ALWAYS" minWidth="480.0" prefWidth="540.0"
               style="-fx-background-color: #ffffff;">
        <ScrollPane fitToWidth="true" fitToHeight="true"
                    styleClass="login-form-scroll">
            <StackPane alignment="CENTER" minHeight="-Infinity" style="-fx-padding: 28px 36px;">
                <VBox alignment="CENTER" maxWidth="440.0" spacing="14">

                    <!-- Brand Header with Rich Gradient Typography -->
                    <VBox alignment="CENTER" spacing="3" maxWidth="Infinity">
                        <Label text="MUSEUMMATE" styleClass="login-brand-title" />
                        <Label text="Sistem Manajemen Koleksi &amp; Konservasi Cagar Budaya"
                               styleClass="login-brand-sub" />
                        <HBox prefHeight="3.0" prefWidth="64.0" maxWidth="64.0"
                              style="-fx-background-color: #174C78; -fx-background-radius: 2px;">
                            <VBox.margin>
                                <Insets top="4" bottom="6" />
                            </VBox.margin>
                        </HBox>
                    </VBox>

                    <!-- Form Heading -->
                    <VBox alignment="CENTER" spacing="3" maxWidth="Infinity">
                        <Label fx:id="lblLoginTitle" text="Masuk ke Akun" styleClass="login-heading" />
                        <Label fx:id="lblLoginSubtitle" text="Pilih peran akun Administrator atau Konservator"
                               styleClass="login-subheading" />
                    </VBox>

                    <!-- Role Switcher Tabs (Admin vs Konservator) -->
                    <VBox spacing="8" maxWidth="Infinity">
                        <Label text="Pilih Peran Pengguna:" styleClass="login-field-label" />
                        <HBox spacing="8" maxWidth="Infinity" style="-fx-background-color: #f1f5f9; -fx-padding: 4px; -fx-background-radius: 10px;">
                            <Button fx:id="btnRoleAdmin" text="🛡️  Administrator" onAction="#handleSelectRoleAdmin"
                                    HBox.hgrow="ALWAYS" maxWidth="Infinity"
                                    style="-fx-background-color: #174C78; -fx-text-fill: #ffffff; -fx-font-weight: bold; -fx-font-size: 12px; -fx-padding: 8px 12px; -fx-background-radius: 8px; -fx-cursor: hand;" />
                            <Button fx:id="btnRoleKonservator" text="🔬  Konservator Museum" onAction="#handleSelectRoleKonservator"
                                    HBox.hgrow="ALWAYS" maxWidth="Infinity"
                                    style="-fx-background-color: transparent; -fx-text-fill: #64748b; -fx-font-weight: bold; -fx-font-size: 12px; -fx-padding: 8px 12px; -fx-background-radius: 8px; -fx-cursor: hand;" />
                        </HBox>
                    </VBox>

                    <!-- Sub-selection: Kategori Spesialisasi Konservator -->
                    <VBox fx:id="boxSpesialisasiKonservator" spacing="6" maxWidth="Infinity" visible="false" managed="false"
                          style="-fx-background-color: #f8fafc; -fx-border-color: #e2e8f0; -fx-border-width: 1px; -fx-border-radius: 10px; -fx-background-radius: 10px; -fx-padding: 10px 12px;">
                        <Label text="Pilih Kategori Konservasi yang Dikelola:" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #0369a1;" />
                        <GridPane hgap="8" vgap="8">
                            <columnConstraints>
                                <ColumnConstraints hgrow="ALWAYS" percentWidth="50" />
                                <ColumnConstraints hgrow="ALWAYS" percentWidth="50" />
                            </columnConstraints>
                            <Button fx:id="btnSpecArtefak" text="🏺 Artefak &amp; Senjata" onAction="#handleSelectSpecArtefak"
                                    maxWidth="Infinity" styleClass="spec-chip-btn-active" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                            <Button fx:id="btnSpecNaskah" text="📜 Naskah Kuno" onAction="#handleSelectSpecNaskah"
                                    maxWidth="Infinity" styleClass="spec-chip-btn" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                            <Button fx:id="btnSpecLukisan" text="🎨 Lukisan Seni" onAction="#handleSelectSpecLukisan"
                                    maxWidth="Infinity" styleClass="spec-chip-btn" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                            <Button fx:id="btnSpecFosil" text="🦴 Fosil &amp; Paleontologi" onAction="#handleSelectSpecFosil"
                                    maxWidth="Infinity" styleClass="spec-chip-btn" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                        </GridPane>
                    </VBox>

                    <!-- Error Banner -->
                    <Label fx:id="lblError" text="" visible="false" managed="false" maxWidth="Infinity"
                           style="-fx-text-fill: #dc2626; -fx-background-color: #fef2f2; -fx-border-color: #fecaca; -fx-border-width: 1px; -fx-padding: 9px 12px; -fx-background-radius: 8px; -fx-border-radius: 8px; -fx-font-size: 12px;" />

                    <!-- Input Username -->
                    <VBox spacing="6" maxWidth="Infinity">
                        <Label text="Username" styleClass="login-field-label" />
                        <HBox fx:id="boxUsername" styleClass="login-input-box" spacing="8">
                            <Label text="👤" styleClass="login-input-icon" />
                            <TextField fx:id="txtUsername" promptText="Masukkan username"
                                       HBox.hgrow="ALWAYS" styleClass="login-text-field" />
                        </HBox>
                    </VBox>

                    <!-- Input Password -->
                    <VBox spacing="6" maxWidth="Infinity">
                        <HBox alignment="CENTER_LEFT">
                            <Label text="Kata Sandi (Password)" styleClass="login-field-label" />
                        </HBox>
                        <HBox fx:id="boxPassword" styleClass="login-input-box" spacing="8">
                            <Label text="🔒" styleClass="login-input-icon" />
                            <StackPane HBox.hgrow="ALWAYS" alignment="CENTER_LEFT">
                                <PasswordField fx:id="txtPassword" promptText="Masukkan kata sandi"
                                               maxWidth="Infinity" styleClass="login-text-field" />
                                <TextField fx:id="txtPasswordPlain" promptText="Masukkan kata sandi"
                                           visible="false" managed="false"
                                           maxWidth="Infinity" styleClass="login-text-field" />
                            </StackPane>
                            <Button fx:id="btnTogglePassword" text="👁" onAction="#togglePasswordVisibility"
                                    styleClass="login-eye-btn" focusTraversable="false" />
                        </HBox>
                    </VBox>

                    <!-- Submit Button -->
                    <Button fx:id="btnLogin" text="Masuk ke Sistem" onAction="#handleLogin"
                            maxWidth="Infinity" styleClass="login-submit-btn">
                        <VBox.margin>
                            <Insets top="2" />
                        </VBox.margin>
                    </Button>

                    <!-- Divider -->
                    <HBox alignment="CENTER" spacing="10" maxWidth="Infinity" style="-fx-padding: 2px 0;">
                        <Separator HBox.hgrow="ALWAYS" />
                        <Label text="Atau Masuk Cepat dengan Akun Demo"
                               style="-fx-font-size: 11px; -fx-text-fill: #94a3b8; -fx-font-weight: 500;" />
                        <Separator HBox.hgrow="ALWAYS" />
                    </HBox>

                    <!-- Demo Quick-Fill: Administrator Mode -->
                    <VBox fx:id="boxDemoAdmin" spacing="8" maxWidth="Infinity">
                        <Button onAction="#fillAdminDemo" maxWidth="Infinity" styleClass="login-demo-btn">
                            <graphic>
                                <HBox alignment="CENTER_LEFT" spacing="12">
                                    <Label text="🛡️" style="-fx-font-size: 18px;" />
                                    <VBox spacing="1">
                                        <Label text="Akun Demo: Administrator Museum Siola" style="-fx-font-weight: bold; -fx-font-size: 12px; -fx-text-fill: #174C78;" />
                                        <Label text="Username: admin | Password: admin123 (Akses Penuh)" style="-fx-font-size: 11px; -fx-text-fill: #64748b;" />
                                    </VBox>
                                </HBox>
                            </graphic>
                        </Button>
                    </VBox>

                    <!-- Demo Quick-Fill: Konservator Mode (4 Specialized Accounts) -->
                    <VBox fx:id="boxDemoKonservator" spacing="8" maxWidth="Infinity" visible="false" managed="false">
                        <GridPane hgap="8" vgap="8">
                            <columnConstraints>
                                <ColumnConstraints hgrow="ALWAYS" percentWidth="50" />
                                <ColumnConstraints hgrow="ALWAYS" percentWidth="50" />
                            </columnConstraints>

                            <Button onAction="#fillDemoArtefak" maxWidth="Infinity" styleClass="login-demo-btn"
                                    GridPane.columnIndex="0" GridPane.rowIndex="0">
                                <graphic>
                                    <VBox spacing="1">
                                        <Label text="🏺 Konservator Artefak" style="-fx-font-weight: bold; -fx-font-size: 11px; -fx-text-fill: #047857;" />
                                        <Label text="Budi Santoso (Artefak)" style="-fx-font-size: 10px; -fx-text-fill: #64748b;" />
                                    </VBox>
                                </graphic>
                            </Button>

                            <Button onAction="#fillDemoNaskah" maxWidth="Infinity" styleClass="login-demo-btn"
                                    GridPane.columnIndex="1" GridPane.rowIndex="0">
                                <graphic>
                                    <VBox spacing="1">
                                        <Label text="📜 Konservator Naskah" style="-fx-font-weight: bold; -fx-font-size: 11px; -fx-text-fill: #0284c7;" />
                                        <Label text="Siti Rahma (Naskah Kuno)" style="-fx-font-size: 10px; -fx-text-fill: #64748b;" />
                                    </VBox>
                                </graphic>
                            </Button>

                            <Button onAction="#fillDemoLukisan" maxWidth="Infinity" styleClass="login-demo-btn"
                                    GridPane.columnIndex="0" GridPane.rowIndex="1">
                                <graphic>
                                    <VBox spacing="1">
                                        <Label text="🎨 Konservator Lukisan" style="-fx-font-weight: bold; -fx-font-size: 11px; -fx-text-fill: #b45309;" />
                                        <Label text="Hendra Wijaya (Lukisan)" style="-fx-font-size: 10px; -fx-text-fill: #64748b;" />
                                    </VBox>
                                </graphic>
                            </Button>

                            <Button onAction="#fillDemoFosil" maxWidth="Infinity" styleClass="login-demo-btn"
                                    GridPane.columnIndex="1" GridPane.rowIndex="1">
                                <graphic>
                                    <VBox spacing="1">
                                        <Label text="🦴 Konservator Fosil" style="-fx-font-weight: bold; -fx-font-size: 11px; -fx-text-fill: #7c3aed;" />
                                        <Label text="Dr. Bambang (Fosil)" style="-fx-font-size: 10px; -fx-text-fill: #64748b;" />
                                    </VBox>
                                </graphic>
                            </Button>
                        </GridPane>
                    </VBox>

                    <!-- Footer Attribution -->
                    <Label text="Team 8, D3 Teknik Informatika PSDKU Lamongan, PENS (2026)"
                           style="-fx-font-size: 11px; -fx-text-fill: #94a3b8; -fx-padding: 4px 0 0 0;" />
                </VBox>
            </StackPane>
        </ScrollPane>
    </StackPane>

</HBox>
