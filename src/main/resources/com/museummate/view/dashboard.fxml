<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<ScrollPane fx:id="rootPane" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.museummate.controller.DashboardController"
            fitToWidth="true" style="-fx-background-color: transparent; -fx-background: #f4f6fb;">

    <VBox spacing="20" style="-fx-padding: 6px 0 24px 0;">
        <!-- Page Title & Header Bar -->
        <HBox alignment="CENTER_LEFT" spacing="16">
            <VBox spacing="3" HBox.hgrow="ALWAYS">
                <Label text="Dashboard Ringkasan Operasional" styleClass="page-title" />
                <Label text="Pemantauan kondisi fisik koleksi museum, status perawatan, grafik tren, dan kalkulasi prioritas otomatis." styleClass="page-subtitle" />
            </VBox>
            <Button text="Segarkan Data" onAction="#refreshDashboard" styleClass="btn-secondary" />
        </HBox>

        <!-- Welcome Hero Banner with Museum Siola 3-Photo Carousel (Figma Frame 489) -->
        <StackPane fx:id="heroBannerPane" styleClass="hero-card-carousel" minHeight="165.0" prefHeight="175.0">

            <!-- Background Carousel Images (Right-aligned, Unmixed Display) -->
            <StackPane fx:id="heroImageContainer" alignment="CENTER_RIGHT"
                       styleClass="hero-carousel-image-container">
                <ImageView fx:id="heroImgCurrent" fitHeight="175.0" preserveRatio="true" StackPane.alignment="CENTER_RIGHT">
                    <image>
                        <Image url="@../images/siola_banner_1.jpg" />
                    </image>
                </ImageView>
                <ImageView fx:id="heroImgNext" fitHeight="175.0" preserveRatio="true" opacity="0.0" StackPane.alignment="CENTER_RIGHT">
                    <image>
                        <Image url="@../images/siola_banner_2.jpg" />
                    </image>
                </ImageView>
            </StackPane>

            <!-- Horizontal Gradient Overlay: Solid Dark on Left for Text, Feathering into Crisp Photo on Right -->
            <Region styleClass="hero-carousel-gradient-overlay" mouseTransparent="true" />

            <!-- Foreground Content: Greeting, Subtitle, and Action Buttons -->
            <HBox alignment="CENTER_LEFT" spacing="20" styleClass="hero-carousel-content">
                <VBox spacing="12" HBox.hgrow="ALWAYS">
                    <VBox spacing="4">
                        <Label fx:id="lblHeroGreetingTitle" text="Selamat Datang, Kurator!"
                               styleClass="hero-greeting-title" />
                        <Label fx:id="lblHeroGreetingSub"
                               text="Sistem mencatat jadwal perawatan aktif dan koleksi prioritas yang memerlukan perhatian konservasi hari ini."
                               styleClass="hero-greeting-sub" wrapText="true" maxWidth="560.0" />
                    </VBox>
                    <HBox alignment="CENTER_LEFT" spacing="12" style="-fx-padding: 4px 0 0 0;">
                        <Button text="Buka Antrean Prioritas" onAction="#handleBukaPrioritas"
                                styleClass="btn-primary" />
                        <Button text="Kelola Jadwal Perawatan" onAction="#handleBukaJadwal"
                                styleClass="hero-btn-glass" />
                    </HBox>
                </VBox>
            </HBox>
        </StackPane>

        <!-- 4 Stat Metric Cards -->
        <HBox spacing="16">
            <!-- Total Koleksi -->
            <VBox styleClass="stat-card" HBox.hgrow="ALWAYS" spacing="4">
                <Label text="TOTAL KOLEKSI TERDAFTAR" styleClass="stat-label" />
                <Label fx:id="lblTotalKoleksi" text="0" styleClass="stat-value" />
                <Label text="Terdata dalam 4 kategori OOP" style="-fx-font-size: 11px; -fx-text-fill: #64748b;" />
            </VBox>

            <!-- Prioritas Kritis -->
            <VBox styleClass="stat-card" HBox.hgrow="ALWAYS" spacing="4" style="-fx-border-color: #fca5a5;">
                <Label text="PRIORITAS KRITIS / TINGGI" styleClass="stat-label" style="-fx-text-fill: #991b1b;" />
                <Label fx:id="lblPrioritasKritis" text="0" styleClass="stat-value" style="-fx-text-fill: #dc2626;" />
                <Label text="Mendesak untuk ditindaklanjuti" style="-fx-font-size: 11px; -fx-text-fill: #b91c1c;" />
            </VBox>

            <!-- Jadwal Terlambat -->
            <VBox styleClass="stat-card" HBox.hgrow="ALWAYS" spacing="4" style="-fx-border-color: #fdba74;">
                <Label text="JADWAL TERLAMBAT" styleClass="stat-label" style="-fx-text-fill: #9a3412;" />
                <Label fx:id="lblJadwalTerlambat" text="0" styleClass="stat-value" style="-fx-text-fill: #d97706;" />
                <Label text="Melewati batas rencana perawatan" style="-fx-font-size: 11px; -fx-text-fill: #ea580c;" />
            </VBox>

            <!-- Kondisi Prima -->
            <VBox styleClass="stat-card" HBox.hgrow="ALWAYS" spacing="4" style="-fx-border-color: #86efac;">
                <Label text="KONDISI BAIK / PRIMA" styleClass="stat-label" style="-fx-text-fill: #166534;" />
                <Label fx:id="lblKondisiBaik" text="0" styleClass="stat-value" style="-fx-text-fill: #16a34a;" />
                <Label text="Stabil dalam ruang vitrin/galeri" style="-fx-font-size: 11px; -fx-text-fill: #15803d;" />
            </VBox>
        </HBox>

        <!-- Row 1: Grafik Tren & Agenda Konservasi (Sejajar) -->
        <HBox spacing="18" alignment="TOP_LEFT">
            <!-- Left Card: Grafik Tren Kondisi Koleksi -->
            <VBox styleClass="card" spacing="12" HBox.hgrow="ALWAYS" prefWidth="500.0">
                <HBox alignment="CENTER_LEFT">
                    <VBox spacing="2" HBox.hgrow="ALWAYS">
                        <Label text="Grafik Tren Kondisi Koleksi dari Waktu ke Waktu" styleClass="card-title" />
                        <Label text="Pola perubahan kondisi fisik per kategori berdasarkan riwayat pemeriksaan (1.0 = Baik, 2.0 = Cukup, 3.0 = Rusak Ringan, 4.0 = Rusak Berat). Garis menurun menandakan keberhasilan konservasi."
                               style="-fx-font-size: 12px; -fx-text-fill: #64748b;" wrapText="true" />
                    </VBox>
                </HBox>
                <LineChart fx:id="chartTrenKondisi" prefHeight="250.0" legendSide="TOP" animated="false">
                    <xAxis>
                        <CategoryAxis fx:id="axisXWaktu" label="Periode Bulan Pemeriksaan" />
                    </xAxis>
                    <yAxis>
                        <NumberAxis fx:id="axisYSkor" label="Indeks Kerusakan (1: Baik → 4: Rusak Berat)"
                                    lowerBound="1.0" upperBound="4.0" tickUnit="0.5" autoRanging="false" />
                    </yAxis>
                </LineChart>
            </VBox>

            <!-- Right Card: Agenda Konservasi -->
            <VBox styleClass="card" spacing="14" HBox.hgrow="ALWAYS" prefWidth="500.0">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="Agenda Konservasi" styleClass="card-title" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Button text="Semua Jadwal" onAction="#handleBukaJadwal" styleClass="btn-secondary, btn-sm" />
                </HBox>

                <!-- Featured Royal Blue Card (Top Schedule) -->
                <VBox fx:id="boxFeaturedSchedule" styleClass="agenda-featured-card" spacing="8">
                    <HBox alignment="CENTER_LEFT">
                        <Label fx:id="lblFeaturedStatus" text="JADWAL TERDEKAT"
                               style="-fx-background-color: rgba(255,255,255,0.25); -fx-text-fill: #ffffff; -fx-font-size: 10px; -fx-font-weight: bold; -fx-padding: 3px 8px; -fx-background-radius: 10px;" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label fx:id="lblFeaturedTanggal" text="20 Okt 2026" style="-fx-text-fill: #dbeafe; -fx-font-size: 11px; -fx-font-weight: bold;" />
                    </HBox>
                    <Label fx:id="lblFeaturedKegiatan" text="Pembersihan Jamur &amp; Konsolidasi" style="-fx-text-fill: #ffffff; -fx-font-weight: bold; -fx-font-size: 14px;" wrapText="true" />
                    <Label fx:id="lblFeaturedKoleksi" text="Koleksi Target: Kitab Kuno Pegon" style="-fx-text-fill: #c8dcee; -fx-font-size: 12px;" wrapText="true" />
                </VBox>

                <!-- Upcoming List -->
                <VBox fx:id="boxUpcomingList" spacing="10" />

                <Label fx:id="lblEmptyUpcoming" text="Tidak ada jadwal perawatan mendatang dalam waktu dekat."
                       style="-fx-text-fill: #94a3b8; -fx-font-size: 12px; -fx-font-style: italic; -fx-padding: 8px 0;" visible="false" managed="false" />
            </VBox>
        </HBox>

        <!-- Row 2: Sebaran Koleksi & Proporsi Kondisi Fisik (Sejajar) -->
        <HBox spacing="18" alignment="TOP_LEFT">
            <!-- Left Card: Sebaran Koleksi Berdasarkan Kategori -->
            <VBox styleClass="card" HBox.hgrow="ALWAYS" prefWidth="500.0" spacing="14">
                <Label text="Sebaran Koleksi Berdasarkan Kategori" styleClass="card-title" />
                <VBox spacing="10">
                    <!-- Naskah Kuno -->
                    <VBox spacing="4">
                        <HBox alignment="CENTER_LEFT">
                            <Label text="Naskah Kuno" style="-fx-text-fill: #1e293b; -fx-font-size: 12px; -fx-font-weight: 600;" maxWidth="Infinity" HBox.hgrow="ALWAYS" />
                            <Label fx:id="lblNaskahCount" text="0 item (0%)" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #174C78;" />
                        </HBox>
                        <ProgressBar fx:id="progressNaskah" progress="0.0" maxWidth="Infinity" styleClass="metric-progress-bar, progress-bar-blue" />
                    </VBox>

                    <!-- Lukisan -->
                    <VBox spacing="4">
                        <HBox alignment="CENTER_LEFT">
                            <Label text="Lukisan Tradisional/Modern" style="-fx-text-fill: #1e293b; -fx-font-size: 12px; -fx-font-weight: 600;" maxWidth="Infinity" HBox.hgrow="ALWAYS" />
                            <Label fx:id="lblLukisanCount" text="0 item (0%)" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #174C78;" />
                        </HBox>
                        <ProgressBar fx:id="progressLukisan" progress="0.0" maxWidth="Infinity" styleClass="metric-progress-bar, progress-bar-blue" />
                    </VBox>

                    <!-- Artefak -->
                    <VBox spacing="4">
                        <HBox alignment="CENTER_LEFT">
                            <Label text="Artefak &amp; Senjata Sejarah" style="-fx-text-fill: #1e293b; -fx-font-size: 12px; -fx-font-weight: 600;" maxWidth="Infinity" HBox.hgrow="ALWAYS" />
                            <Label fx:id="lblArtefakCount" text="0 item (0%)" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #174C78;" />
                        </HBox>
                        <ProgressBar fx:id="progressArtefak" progress="0.0" maxWidth="Infinity" styleClass="metric-progress-bar, progress-bar-blue" />
                    </VBox>

                    <!-- Fosil -->
                    <VBox spacing="4">
                        <HBox alignment="CENTER_LEFT">
                            <Label text="Fosil &amp; Paleontologi" style="-fx-text-fill: #1e293b; -fx-font-size: 12px; -fx-font-weight: 600;" maxWidth="Infinity" HBox.hgrow="ALWAYS" />
                            <Label fx:id="lblFosilCount" text="0 item (0%)" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #174C78;" />
                        </HBox>
                        <ProgressBar fx:id="progressFosil" progress="0.0" maxWidth="Infinity" styleClass="metric-progress-bar, progress-bar-blue" />
                    </VBox>
                </VBox>
            </VBox>

            <!-- Right Card: Proporsi Kondisi Fisik -->
            <VBox styleClass="card" HBox.hgrow="ALWAYS" prefWidth="500.0" spacing="14">
                <Label text="Proporsi Kondisi Fisik Terkini" styleClass="card-title" />
                <VBox spacing="10">
                    <!-- Baik -->
                    <VBox spacing="4">
                        <HBox alignment="CENTER_LEFT">
                            <Label text="● Kondisi Baik" style="-fx-text-fill: #16a34a; -fx-font-size: 12px; -fx-font-weight: 600;" maxWidth="Infinity" HBox.hgrow="ALWAYS" />
                            <Label fx:id="lblDetilBaik" text="0 (0%)" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #16a34a;" />
                        </HBox>
                        <ProgressBar fx:id="progressBaik" progress="0.0" maxWidth="Infinity" styleClass="metric-progress-bar, progress-bar-green" />
                    </VBox>

                    <!-- Cukup -->
                    <VBox spacing="4">
                        <HBox alignment="CENTER_LEFT">
                            <Label text="● Kondisi Cukup" style="-fx-text-fill: #174C78; -fx-font-size: 12px; -fx-font-weight: 600;" maxWidth="Infinity" HBox.hgrow="ALWAYS" />
                            <Label fx:id="lblDetilCukup" text="0 (0%)" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #174C78;" />
                        </HBox>
                        <ProgressBar fx:id="progressCukup" progress="0.0" maxWidth="Infinity" styleClass="metric-progress-bar, progress-bar-blue" />
                    </VBox>

                    <!-- Rusak Ringan -->
                    <VBox spacing="4">
                        <HBox alignment="CENTER_LEFT">
                            <Label text="● Rusak Ringan" style="-fx-text-fill: #d97706; -fx-font-size: 12px; -fx-font-weight: 600;" maxWidth="Infinity" HBox.hgrow="ALWAYS" />
                            <Label fx:id="lblDetilRingan" text="0 (0%)" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #d97706;" />
                        </HBox>
                        <ProgressBar fx:id="progressRingan" progress="0.0" maxWidth="Infinity" styleClass="metric-progress-bar, progress-bar-amber" />
                    </VBox>

                    <!-- Rusak Berat -->
                    <VBox spacing="4">
                        <HBox alignment="CENTER_LEFT">
                            <Label text="● Rusak Berat" style="-fx-text-fill: #dc2626; -fx-font-size: 12px; -fx-font-weight: 600;" maxWidth="Infinity" HBox.hgrow="ALWAYS" />
                            <Label fx:id="lblDetilBerat" text="0 (0%)" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #dc2626;" />
                        </HBox>
                        <ProgressBar fx:id="progressBerat" progress="0.0" maxWidth="Infinity" styleClass="metric-progress-bar, progress-bar-red" />
                    </VBox>
                </VBox>
            </VBox>
        </HBox>
    </VBox>
</ScrollPane>
