<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.museummate.controller.MainLayoutController"
            prefHeight="750.0" prefWidth="1200.0"
            stylesheets="@../css/style.css">

    <!-- Left Sidebar Navigation -->
    <left>
        <VBox styleClass="sidebar" spacing="6">
            <!-- Brand Header -->
            <VBox spacing="3" style="-fx-padding: 0 0 18px 0;">
                <Label text="MuseumMate" styleClass="sidebar-brand-title" />
                <Label text="Museum Surabaya (Gedung Siola)" styleClass="sidebar-brand-subtitle" style="-fx-text-fill: #38bdf8; -fx-font-size: 11px; -fx-font-weight: bold;" />
            </VBox>

            <!-- User Session Card -->
            <VBox styleClass="user-profile-box" spacing="4">
                <Label fx:id="lblNamaPengguna" text="Nama Pengguna" styleClass="user-name-label" />
                <Label fx:id="lblPeranPengguna" text="ADMINISTRATOR" styleClass="user-role-badge" />
            </VBox>

            <Separator style="-fx-padding: 6px 0; -fx-opacity: 0.2;" />

            <!-- Nav Links -->
            <Button fx:id="btnNavDashboard" text="📊  Dashboard Ringkasan" onAction="#showDashboard"
                    maxWidth="Infinity" styleClass="nav-button" />

            <Button fx:id="btnNavKoleksi" text="🏛️  Data Koleksi (F2/F3)" onAction="#showKoleksi"
                    maxWidth="Infinity" styleClass="nav-button" />

            <Button fx:id="btnNavPrioritas" text="⚡  Prioritas Perawatan (F6)" onAction="#showPrioritas"
                    maxWidth="Infinity" styleClass="nav-button" />

            <Button fx:id="btnNavPemeriksaan" text="📋  Catat Pemeriksaan (F4)" onAction="#showPemeriksaan"
                    maxWidth="Infinity" styleClass="nav-button" />

            <Button fx:id="btnNavJadwal" text="📅  Jadwal Perawatan (F5)" onAction="#showJadwal"
                    maxWidth="Infinity" styleClass="nav-button" />

            <Button fx:id="btnNavNotifikasi" text="🔔  Notifikasi Jadwal (F8)" onAction="#showNotifikasi"
                    maxWidth="Infinity" styleClass="nav-button" />

            <!-- Admin Only Nav Links -->
            <Button fx:id="btnNavLogAudit" text="📜  Log Audit (F10)" onAction="#showLogAudit"
                    maxWidth="Infinity" styleClass="nav-button" />

            <Button fx:id="btnNavPengguna" text="👥  Kelola Akun (F1)" onAction="#showPengguna"
                    maxWidth="Infinity" styleClass="nav-button" />


            <!-- Spacer -->
            <Region VBox.vgrow="ALWAYS" />

            <Separator style="-fx-padding: 6px 0; -fx-opacity: 0.2;" />

            <Button text="🚪  Keluar (Logout)" onAction="#handleLogout"
                    maxWidth="Infinity" styleClass="nav-button" style="-fx-text-fill: #f87171;" />
        </VBox>
    </left>

    <!-- Main Content Area -->
    <center>
        <VBox styleClass="main-container">
            <!-- Top Navbar (Search, Date, Notification, User Profile) -->
            <HBox styleClass="top-navbar" alignment="CENTER_LEFT" spacing="16">
                <!-- Search Box -->
                <HBox styleClass="search-box" alignment="CENTER_LEFT" spacing="8" HBox.hgrow="ALWAYS">
                    <Label text="🔍" style="-fx-text-fill: #94a3b8; -fx-font-size: 12px;" />
                    <TextField fx:id="txtGlobalSearch" promptText="Cari koleksi, nomor registrasi, kategori..."
                               styleClass="search-input" HBox.hgrow="ALWAYS" onAction="#handleGlobalSearch" />
                </HBox>

                <!-- Right Info & Actions -->
                <HBox alignment="CENTER_RIGHT" spacing="14">
                    <Label fx:id="lblTanggalHariIni" text="Senin, 19 Okt 2026" styleClass="header-date-badge" />
                    <Button fx:id="btnTopNotifikasi" text="🔔 Notifikasi" onAction="#showNotifikasi" styleClass="icon-btn-header" />
                    <HBox alignment="CENTER" spacing="10" styleClass="header-user-profile">
                        <StackPane styleClass="avatar-circle">
                            <Label fx:id="lblAvatarInitials" text="AS" styleClass="avatar-text" />
                        </StackPane>
                        <VBox alignment="CENTER_LEFT" spacing="1">
                            <Label fx:id="lblHeaderUserName" text="Nama Pengguna" styleClass="header-user-name" />
                            <Label fx:id="lblHeaderUserRole" text="ADMINISTRATOR" styleClass="header-user-role" />
                        </VBox>
                    </HBox>
                </HBox>
            </HBox>

            <!-- Dynamic View StackPane -->
            <StackPane fx:id="contentArea" styleClass="content-area" VBox.vgrow="ALWAYS" />
        </VBox>
    </center>

</BorderPane>
