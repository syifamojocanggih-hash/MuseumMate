<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.museummate.controller.NotifikasiController"
      spacing="16" style="-fx-background-color: transparent;">

    <!-- Page Header -->
    <HBox alignment="CENTER_LEFT" spacing="16">
        <VBox spacing="3" HBox.hgrow="ALWAYS">
            <Label text="Peringatan &amp; Notifikasi Jadwal Perawatan (PRD F8 / UC-11)" styleClass="page-title" />
            <Label text="Peringatan dini jadwal konservasi yang telah melewati tanggal rencana atau akan jatuh tempo dalam 7 hari ke depan."
                   styleClass="page-subtitle" />
        </VBox>
        <Button text="🔄 Segarkan Notifikasi" onAction="#handleRefresh" styleClass="btn-secondary" />
    </HBox>

    <!-- Stat Notification Summary Cards -->
    <HBox spacing="16">
        <VBox styleClass="stat-card" HBox.hgrow="ALWAYS" spacing="4">
            <Label text="TOTAL NOTIFIKASI AKTIF" styleClass="stat-label" />
            <Label fx:id="lblTotalNotifikasi" text="0" styleClass="stat-value" />
            <Label text="Jadwal yang memerlukan tindak lanjut segera" style="-fx-font-size: 11px; -fx-text-fill: #64748b;" />
        </VBox>

        <VBox styleClass="stat-card" HBox.hgrow="ALWAYS" spacing="4" style="-fx-border-color: #fca5a5;">
            <Label text="LEWAT JATUH TEMPO (OVERDUE)" styleClass="stat-label" style="-fx-text-fill: #991b1b;" />
            <Label fx:id="lblTerlambatCount" text="0" styleClass="stat-value" style="-fx-text-fill: #dc2626;" />
            <Label text="Telah melewati tanggal rencana belum selesai" style="-fx-font-size: 11px; -fx-text-fill: #b91c1c;" />
        </VBox>

        <VBox styleClass="stat-card" HBox.hgrow="ALWAYS" spacing="4" style="-fx-border-color: #fde68a;">
            <Label text="JATUH TEMPO 7 HARI KE DEPAN" styleClass="stat-label" style="-fx-text-fill: #92400e;" />
            <Label fx:id="lblMendatangCount" text="0" styleClass="stat-value" style="-fx-text-fill: #d97706;" />
            <Label text="Persiapan material &amp; tim konservasi laboratorium" style="-fx-font-size: 11px; -fx-text-fill: #b45309;" />
        </VBox>
    </HBox>

    <!-- Notification Table Card -->
    <VBox styleClass="card" VBox.vgrow="ALWAYS" spacing="12">
        <HBox alignment="CENTER_LEFT" spacing="12">
            <Label text="Daftar Peringatan Jadwal Perawatan" styleClass="card-title" />
            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="btnTandaiSelesai" text="✅ Tandai Selesai" onAction="#handleTandaiSelesai" styleClass="btn-secondary" />
        </HBox>

        <TableView fx:id="tableNotifikasi" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colStatusNotifikasi" text="Status Peringatan" prefWidth="180.0" />
                <TableColumn fx:id="colTanggalRencana" text="Tanggal Rencana" prefWidth="130.0" />
                <TableColumn fx:id="colKodeKoleksi" text="Kode Koleksi" prefWidth="130.0" />
                <TableColumn fx:id="colNamaKoleksi" text="Nama Koleksi" prefWidth="250.0" />
                <TableColumn fx:id="colKegiatan" text="Rencana Tindakan / Kegiatan" prefWidth="240.0" />
                <TableColumn fx:id="colKeterangan" text="Keterangan / Catatan" prefWidth="220.0" />
            </columns>
            <placeholder>
                <Label text="Semua jadwal perawatan dalam kondisi aman. Tidak ada jadwal terlambat atau mendesak." />
            </placeholder>
        </TableView>

        <HBox alignment="CENTER_LEFT">
            <Label fx:id="lblStatusData" text="Menampilkan jadwal aktif yang memerlukan perhatian."
                   style="-fx-font-size: 12px; -fx-text-fill: #64748b;" />
        </HBox>
    </VBox>

</VBox>
