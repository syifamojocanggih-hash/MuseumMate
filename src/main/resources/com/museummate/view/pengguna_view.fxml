<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.museummate.controller.PenggunaController"
      spacing="16">

    <!-- Header Section -->
    <HBox alignment="CENTER_LEFT" spacing="16">
        <VBox spacing="3" HBox.hgrow="ALWAYS">
            <Label text="Pengelolaan Akun Pengguna (Khusus Administrator)" styleClass="page-title" />
            <Label text="Kelola hak akses sistem antara peran Administrator dan Konservator (PRD F1)." styleClass="page-subtitle" />
        </VBox>
        <Button text="+ Tambah Akun Baru" onAction="#handleTambahPengguna" styleClass="btn-primary" />
    </HBox>

    <!-- Table of Users -->
    <VBox styleClass="card" VBox.vgrow="ALWAYS" spacing="10">
        <TableView fx:id="tablePengguna" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colId" text="ID" prefWidth="60.0" />
                <TableColumn fx:id="colUsername" text="Username" prefWidth="160.0" />
                <TableColumn fx:id="colNamaLengkap" text="Nama Lengkap" prefWidth="280.0" />
                <TableColumn fx:id="colPeran" text="Hak Akses / Peran" prefWidth="180.0" />
                <TableColumn fx:id="colDibuatPada" text="Waktu Dibuat" prefWidth="200.0" />
            </columns>
            <placeholder>
                <Label text="Belum ada pengguna terdaftar." />
            </placeholder>
        </TableView>

        <!-- Actions -->
        <HBox alignment="CENTER_RIGHT" spacing="10" style="-fx-padding: 6px 0 0 0;">
            <Region HBox.hgrow="ALWAYS" />
            <Button text="✏️ Ubah Akun" onAction="#handleUbahPengguna" styleClass="btn-secondary" />
            <Button text="🗑️ Hapus Akun" onAction="#handleHapusPengguna" styleClass="btn-danger" />
        </HBox>
    </VBox>

</VBox>
