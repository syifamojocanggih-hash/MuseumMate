<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.museummate.controller.KoleksiController"
      spacing="16">

    <!-- Header Section -->
    <HBox alignment="CENTER_LEFT" spacing="16">
        <VBox spacing="3" HBox.hgrow="ALWAYS">
            <Label text="Manajemen Data Koleksi Museum" styleClass="page-title" />
            <Label text="Pencatatan inventaris empat kategori benda bersejarah beserta atribut spesifik dan lokasi penyimpanan." styleClass="page-subtitle" />
        </VBox>
        <HBox spacing="10">
            <Button text="📄 Cetak Laporan PDF" onAction="#handleExportPdf" styleClass="btn-secondary" />
            <Button fx:id="btnTambah" text="+ Tambah Koleksi Baru" onAction="#handleTambahKoleksi" styleClass="btn-primary" />
        </HBox>
    </HBox>

    <!-- Filter & Search Toolbar (PRD F2: satu aksi tanpa reload manual) -->
    <HBox styleClass="card" spacing="12" alignment="CENTER_LEFT" style="-fx-padding: 12px 16px;">
        <Label text="Pencarian:" styleClass="form-label" style="-fx-padding: 6px 0 0 0;" />
        <TextField fx:id="txtSearch" promptText="Cari nama, kode registrasi, asal, bahan..." HBox.hgrow="ALWAYS" />

        <Label text="Kategori:" styleClass="form-label" style="-fx-padding: 6px 0 0 0;" />
        <ComboBox fx:id="cmbKategoriFilter" prefWidth="140.0" promptText="Semua Kategori" />

        <Label text="Kondisi:" styleClass="form-label" style="-fx-padding: 6px 0 0 0;" />
        <ComboBox fx:id="cmbKondisiFilter" prefWidth="140.0" promptText="Semua Kondisi" />

        <Button text="Reset" onAction="#handleResetFilter" styleClass="btn-secondary" style="-fx-padding: 6px 12px;" />
    </HBox>

    <!-- Table of Collections -->
    <VBox styleClass="card" VBox.vgrow="ALWAYS" spacing="10">
        <TableView fx:id="tableKoleksi" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colKode" text="Kode Registrasi" prefWidth="120.0" />
                <TableColumn fx:id="colNama" text="Nama Benda Koleksi" prefWidth="250.0" />
                <TableColumn fx:id="colKategori" text="Kategori" prefWidth="110.0" />
                <TableColumn fx:id="colKondisi" text="Kondisi" prefWidth="120.0" />
                <TableColumn fx:id="colAsal" text="Asal / Budaya" prefWidth="140.0" />
                <TableColumn fx:id="colBahan" text="Bahan" prefWidth="130.0" />
                <TableColumn fx:id="colLokasi" text="Lokasi Simpan" prefWidth="160.0" />
                <TableColumn fx:id="colAtributKhusus" text="Atribut Khusus (OOP)" prefWidth="220.0" />
            </columns>
            <placeholder>
                <Label text="Tidak ada data koleksi yang cocok dengan filter pencarian." />
            </placeholder>
        </TableView>

        <!-- Bottom Action Bar -->
        <HBox alignment="CENTER_RIGHT" spacing="10" style="-fx-padding: 6px 0 0 0;">
            <Label fx:id="lblStatusData" text="Menampilkan 0 koleksi" style="-fx-text-fill: #64748b; -fx-font-size: 12px;" HBox.hgrow="ALWAYS" />
            <Region HBox.hgrow="ALWAYS" />
            <Button text="🔍 Detail Lengkap" onAction="#handleLihatDetail" styleClass="btn-secondary" />
            <Button fx:id="btnUbah" text="✏️ Ubah Data" onAction="#handleUbahKoleksi" styleClass="btn-secondary" />
            <Button fx:id="btnHapus" text="🗑️ Hapus" onAction="#handleHapusKoleksi" styleClass="btn-danger" />
        </HBox>
    </VBox>

</VBox>
